+// ===== engram-tier access-heat probe (begin) =====
+// Emits each n-gram key consulted by the speculative draft loop to a heat
+// log, one colon-separated key per line, when ENGRAM_TIER_PROFILE=1 is set
+// in the environment (log path: $ENGRAM_TIER_HEAT_LOG, default
+// "engram-tier.heat.log"). Zero-cost when the gate is unset: the enabled
+// flag initializes once and the write path is skipped entirely.
+// Keys whose n-gram size falls outside [2, 3] tokens are not emitted — the
+// EngramTier heat model covers the 2-3-token keyed table range. Aggregation
+// lives in the Go heat collector; this probe only emits raw lookups.
+namespace engram {
+static void probe_emit(const llama_token * tokens) {
+    static const bool enabled = std::getenv("ENGRAM_TIER_PROFILE") != nullptr;
+    if (!enabled) {
+        return;
+    }
+    static FILE * log = [] () {
+        const char * path = std::getenv("ENGRAM_TIER_HEAT_LOG");
+        FILE * f = std::fopen(path ? path : "engram-tier.heat.log", "a");
+        if (f) {
+            std::fputs("# engram-tier heat-log v1\n", f);
+        }
+        return f;
+    }();
+    if (!log) {
+        return;
+    }
+    int n = 0;
+    while (n < LLAMA_NGRAM_MAX && tokens[n] != LLAMA_TOKEN_NULL) {
+        ++n;
+    }
+    if (n < 2 || n > 3) {
+        return;
+    }
+    for (int i = 0; i < n; ++i) {
+        if (i) {
+            std::fputc(':', log);
+        }
+        std::fprintf(log, "%d", static_cast<int>(tokens[i]));
+    }
+    std::fputc('\n', log);
+    static std::uint64_t emitted = 0;
+    if ((++emitted & 0x3ff) == 0) {
+        std::fflush(log);
+    }
+}
+} // namespace engram
