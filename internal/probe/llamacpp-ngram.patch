# EngramTier llama.cpp n-gram access-heat probe
#
# Wraps the speculative-decoding n-gram cache lookup with a per-call emitter
# that, when ENGRAM_TIER_PROFILE=1 is set in the environment, appends every
# looked-up n-gram key (one per line, colon-separated token ids) to the heat
# log at $ENGRAM_TIER_HEAT_LOG (default: engram-tier.heat.log). When the env
# var is unset the probe compiles to a single branch-never-taken, so the same
# binary serves both profile and serve modes with zero overhead in serve.
#
# Apply from the llama.cpp repo root:  git apply --whitespace=fix <this-file>
# Revert with:                          git apply -R <this-file>
#
# The probe deliberately emits raw lookups (one key per line) and leaves
# aggregation to the Go heat collector — keeping "which keys are hot" a single
# source of truth in pure-Go, testable code.
--- a/examples/speculative/llama-ngram-cache.h
+++ b/examples/speculative/llama-ngram-cache.h
@@ -28,6 +28,7 @@
 #include <string>
 #include <thread>
 #include <unordered_map>
+#include <cstdlib>  // engram-tier: getenv for profile gate

 // MACRO values from the draft of the paper "Speculative Decoding for n-gram
 // lookup" (Tobin, 2025).
@@ -145,6 +146,42 @@ struct ngram_cache {
         const int n_decode = std::min(n_draft, n_ctx - 1 - kv_pos);
         if (n_decode <= 0) return;

+        // ===== engram-tier access-heat probe (begin) =====
+        // Emits the looked-up n-gram key (the sliding-window token sequence
+        // used to index this entry) to a heat log when ENGRAM_TIER_PROFILE=1.
+        // Zero-cost when the gate is unset: getenv is called once per session
+        // and the file write is skipped entirely.
+        static const bool engram_profile = std::getenv("ENGRAM_TIER_PROFILE") != nullptr;
+        static FILE * engram_log = nullptr;
+        if (engram_profile && engram_log == nullptr) {
+            const char * path = std::getenv("ENGRAM_TIER_HEAT_LOG");
+            engram_log = std::fopen(path ? path : "engram-tier.heat.log", "a");
+            if (engram_log) {
+                std::fputs("# engram-tier heat-log v1\n", engram_log);
+            }
+        }
+        if (engram_profile && engram_log != nullptr) {
+            // Emit the input tokens that form this n-gram key, colon-
+            // separated to match the Go NGramKey.String() format.
+            for (int i = 0; i < ngram_n; ++i) {
+                if (i) std::fputc(':', engram_log);
+                std::fprintf(engram_log, "%u", static_cast<unsigned>(input_ids[i]));
+            }
+            std::fputc('\n', engram_log);
+            // Bounded buffering so a long generation does not block decode;
+            // fflush on session teardown flushes the tail.
+            if ((++engram_probe_count_ & 0x3ff) == 0) {
+                std::fflush(engram_log);
+            }
+        }
+        // ===== engram-tier access-heat probe (end) =====
+
         int n_past = 1;
         for (int i = 1; i <= n_decode; ++i) {
             int n_drafted = i;
@@ -340,3 +377,8 @@ struct ngram_cache {
     // and for all other threads.
     std::vector<std::unordered_map< llama_token, std::vector<token_static_sample>>> cache;
 };
+
+// engram-tier: probe call counter for bounded flush, lives at file scope so
+// the static-in-function init above can refer to it across calls.
+namespace { static std::uint64_t engram_probe_count_ = 0; }
--- a/examples/speculative/CMakeLists.txt
+++ b/examples/speculative/CMakeLists.txt
@@ -1,5 +1,6 @@
 # llama.cpp speculative decoding example — n-gram lookup cache
+# (engram-tier probe adds no build flag; instrumentation is env-gated)
 set(TARGET llama-speculative)
 add_executable(${TARGET} main.cpp
     llama-ngram-cache.h)
